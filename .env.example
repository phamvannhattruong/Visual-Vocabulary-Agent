# Gemini API Key (Required for AI Agents)
API_KEY_GEMINI=your_gemini_api_key_here

# Groq API Key (Optional for dataset generation)
GROQ_API_KEY=your_groq_api_key_here

# HuggingFace Token (Optional for model downloads)
HF_TOKEN=your_huggingface_token_here

# ====================================================================
# Database Configuration
# ====================================================================
# 1. SQL Server - Windows Authentication (SQLEXPRESS / Local default):
DATABASE_URL=mssql+pyodbc://@localhost\SQLEXPRESS/english_learning_app?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes&TrustServerCertificate=yes

# 2. SQL Server - SQL Authentication (User/Password):
# DATABASE_URL=mssql+pyodbc://username:password@localhost:1433/english_learning_app?driver=ODBC+Driver+17+for+SQL+Server&TrustServerCertificate=yes

# 3. PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/english_learning_app

# 4. SQLite (Local fallback file, zero configuration):
# DATABASE_URL=sqlite:///./database/english_learning_app.db

DB_CONNECT_TIMEOUT=3

